@using Proje_OOP.Entity
@model List<Customer>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_CoreLayout.cshtml";
}

<h1>Musteri Sayfasi</h1>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Musteri Adi</th>
        <th>Musteri Sehir</th>
        <th>Sil</th>
        <th>Guncelle</th>
    </tr>
    @foreach (var item in Model)/*veriler liste halinde alınıp sergileniyor*/
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.City</td>
            <td><a href="/Customer/DeleteCustomer/@item.Id" class="btn btn-danger">Sil</a></td>
            <td><a href="/Customer/UpdateCustomer/@item.Id" class="btn btn-success">Guncelle</a></td>
        </tr>
    }
</table>
<a href="/Customer/AddCustomer/" class="btn btn-primary">Yeni Musteri Girisi</a>